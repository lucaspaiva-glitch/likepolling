# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Plaid (dashboard.plaid.com -> Developers -> Keys)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox

# Optional: protect the dashboard with HTTP Basic Auth, format user:password
DASHBOARD_BASIC_AUTH=

# Vercel: random string; Vercel Cron sends it as a Bearer token to /api/cron/sync
CRON_SECRET=
# Optional: override the Plaid webhook URL (defaults to https://$VERCEL_PROJECT_PRODUCTION_URL/api/plaid/webhook)
PLAID_WEBHOOK_URL=
